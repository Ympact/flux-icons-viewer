{
    "name": "ympact/flux-common-mark",
    "description": "A package to transform markdown into Livewire Flux components.",
    "keywords": ["flux", "laravel", "livewire", "components", "ui", "markdown", "common mark"],
    "type": "library",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0",
        "illuminate/console": "^10.0|^11.0",
        "illuminate/view": "^10.0|^11.0",
        "symfony/console": "^6.0|^7.0",
        "laravel/prompts": "^0.1|^0.2|^0.3",
        "livewire/flux": "^1.0",
        "league/commonmark": "^1.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0|^10.0|^11.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.5"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Ympact\\FluxMarkDown\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ympact\\FluxMarkDown\\FluxMarkDownServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "Maurits",
            "email": "maurits@ympact-technologies.nl"
        }
    ],
    "minimum-stability": "stable"
}
